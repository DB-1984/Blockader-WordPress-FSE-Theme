{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "contrast",
          "color": "#000000",
          "name": "Black"
        },
        {
          "slug": "neon",
          "color": "#e2ff00",
          "name": "Neon"
        },
        {
          "slug": "grey",
          "color": "#bfbfc1",
          "name": "Grey"
        },
        {
          "slug": "dark",
          "color": "#1a1a1a",
          "name": "Dark"
        },
        {
          "slug": "off-white",
          "color": "#f5f5f0",
          "name": "Off White"
        },
        {
          "slug": "neon-muted",
          "color": "#c8d400",
          "name": "Neon Muted"
        },
        {
          "slug": "charcoal",
          "color": "#4a4a4a",
          "name": "Charcoal"
        }
      ],
      "background": true,
      "text": true,
      "custom": false,
      "customGradient": false,
      "defaultPalette": false
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "fontSizes": [
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "lg",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "2.5rem",
          "name": "XL"
        },
        {
          "slug": "hero",
          "size": "60cqi",
          "name": "Hero"
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "Chivo, system-ui, sans-serif",
          "name": "Chivo",
          "slug": "Chivo",
          "fontFace": [
            {
              "fontFamily": "Chivo",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/Chivo.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Infister, system-ui, sans-serif",
          "name": "Infister",
          "slug": "Infister",
          "fontFace": [
            {
              "fontFamily": "Infister",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/InfisterRegular.woff2"]
            }
          ]
        }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        {
          "slug": "hero-padding",
          "size": "clamp(1rem, 5vw, 3rem)",
          "name": "Hero Padding"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--chivo)"
    },
    "color": {
      "background": "var(--wp--preset--color--charcoal)",
      "text": "var(--wp--preset--color--base)"
    },
    "spacing": {
      "blockGap": "2rem",
      "padding": {
        "top": "0px",
        "right": "1rem",
        "bottom": "0px",
        "left": "1rem"
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontSize": "1rem",
          "lineHeight": "1.7",
          "fontWeight": "200"
        }
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--neon)"
        }
      },
      "h1": {
        "color": {
          "text": "var(--wp--preset--color--neon)"
        },
        "typography": {
          "fontSize": "clamp(3rem, 8vw, 7rem)",
          "lineHeight": "1.3",
          "fontWeight": "800"
        }
      },
      "h2": {
        "color": {
          "text": "var(--wp--preset--color--neon)"
        },
        "typography": {
          "fontSize": "clamp(2.25rem, 6vw, 5rem)",
          "lineHeight": "1.3",
          "fontWeight": "800"
        }
      },
      "h3": {
        "color": {
          "text": "var(--wp--preset--color--neon)"
        },
        "typography": {
          "fontSize": "clamp(1.75rem, 4vw, 3rem)",
          "lineHeight": "1.3",
          "fontWeight": "700"
        }
      },
      "h4": {
        "color": {
          "text": "var(--wp--preset--color--neon)"
        },
        "typography": {
          "fontSize": "1.5rem",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "h5": {
        "color": {
          "text": "var(--wp--preset--color--neon)"
        },
        "typography": {
          "fontSize": "1.2rem",
          "lineHeight": "1.3",
          "fontWeight": "700"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "Main Navigation",
      "slug": "main-nav"
    },
    {
      "area": "footer",
      "name": "Footer",
      "slug": "site-footer"
    }
  ]
}